# 忽略依赖目录（体积大，用 npm install 还原）
node_modules/

# 打包产物
release/
dist/
build/

# 日志
*.log
npm-debug.log*
yarn-error.log*

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 调试 / 提交临时文件
_dbg*.txt
_run*.txt
_t*.txt
_commit_msg.txt

# 示例文库（含本地数据，不随程序一起提交）
文件库/

# 文库自带的标签库（用户数据，随文库存放，不应随程序提交）
.library-tags.json

# ffmpeg 二进制（体积大，不随源码提交；需自行下载放到 vendor/ffmpeg/ffmpeg.exe）
# 获取方式见 README v0.4.6 版本节。打包时 extraResources 会带上本地的这个文件。
vendor/ffmpeg/
